# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# Playwright (E2E / otomasi UAT) — artefak lari, bukan sumber.
# Browser-nya sendiri tinggal di luar repo (~/AppData/Local/ms-playwright).
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# Contoh konfigurasi sengaja dilacak — tidak memuat rahasia apa pun.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
